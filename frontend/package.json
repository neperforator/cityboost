    "@storybook/vue3": "^8.3.0",
    "@storybook/vue3-vite": "^8.3.0",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^15.7.0",
    "postcss": "^8.4.0",
    "storybook": "^8.3.0",
    "tailwindcss": "^3.4.0",
