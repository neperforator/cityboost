# =============================================================================
# CityBoost — Конфигурация окружения
# Скопируйте в .env и подставьте свои значения
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=cityboost
POSTGRES_PASSWORD=cityboost_secret
POSTGRES_DB=cityboost
DATABASE_URL=postgresql+asyncpg://cityboost:cityboost_secret@db:5432/cityboost

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME=CityBoost
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# --- Storage / Files ---
UPLOAD_DIR=storage/uploads/tickets
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_TICKET=5

# --- SMTP / Email (оставьте пустым, если не нужно) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cityboost.ru
SMTP_USE_TLS=true

# --- Frontend (для ссылок в письмах) ---
FRONTEND_URL=http://localhost:5173

# --- Sentry (опционально, для production) ---
SENTRY_DSN=

# --- Geocoding ---
GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_SECONDS=2
