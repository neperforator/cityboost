# =============================================================================
# CityBoost — Конфигурация окружения (шаблон)
# Скопируйте в .env и подставьте свои значения.
# Этот файл никто не читает — рабочий конфиг лежит в ./.env (docker-compose).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=cityboost
POSTGRES_PASSWORD=cityboost_secret
POSTGRES_DB=cityboost
DATABASE_URL=postgresql+asyncpg://cityboost:cityboost_secret@db:5432/cityboost

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME=CityBoost
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- API Docs ---
# Показывать Swagger/ReDoc даже при DEBUG=false (по умолчанию доки = DEBUG)
ENABLE_DOCS=false

# --- Debug: регистрация и вход без почты ---
# true  -> новый аккаунт сразу подтверждён, вход не требует кода из письма,
#          админский 2FA пропускается. Нужен только для локальной разработки.
# false -> обычное поведение: письмо с кодом и 2FA.
# ВАЖНО: работает только при DEBUG=true. Если DEBUG=false, а флаг true —
# backend не запустится (защита от случайного включения на production).
DEBUG_BYPASS_EMAIL_AUTH=false

# --- Admin 2FA (код на email) ---
# Обязательное подтверждение входа для администраторов через 6-значный код.
# Требует настроенного SMTP. Сам код в логи не пишется.
ADMIN_2FA_ENABLED=true
ADMIN_2FA_CODE_TTL_MINUTES=10
ADMIN_2FA_CHALLENGE_TTL_MINUTES=10
ADMIN_2FA_MAX_ATTEMPTS=5
ADMIN_2FA_RESEND_COOLDOWN_SECONDS=60

# --- Refresh cookie (httpOnly, XSS-безопасный refresh token) ---
# REFRESH_COOKIE_SECURE вычисляется автоматически из DEBUG:
#   DEBUG=true  -> cookie без Secure (удобно для localhost по http)
#   DEBUG=false -> cookie только по HTTPS
# Не задавайте вручную, если не уверены. Для production можно явно указать true.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_SECURE=true

# --- Storage / Files ---
UPLOAD_DIR=storage/uploads/tickets
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_TICKET=5

# --- SMTP / Email (оставьте пустым, если не нужно) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cityboost.ru
SMTP_USE_TLS=true

# --- Frontend (для ссылок в письмах) ---
FRONTEND_URL=http://localhost:5173

# --- Geocoding ---
GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_SECONDS=2

TRUST_PROXY_HEADERS=false
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
